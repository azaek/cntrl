{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cntrl.pw/protocol/v1/schema.json",
  "title": "cntrl agent protocol v1",
  "$ref": "#/$defs/Frame",
  "$defs": {
    "Frame": {
      "oneOf": [
        {
          "$ref": "#/$defs/Challenge",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "challenge"
            }
          },
          "required": [
            "t"
          ]
        },
        {
          "$ref": "#/$defs/Hello",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "hello"
            }
          },
          "required": [
            "t"
          ]
        },
        {
          "$ref": "#/$defs/Welcome",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "welcome"
            }
          },
          "required": [
            "t"
          ]
        },
        {
          "$ref": "#/$defs/Request",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "req"
            }
          },
          "required": [
            "t"
          ]
        },
        {
          "$ref": "#/$defs/Response",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "res"
            }
          },
          "required": [
            "t"
          ]
        },
        {
          "$ref": "#/$defs/Progress",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "prog"
            }
          },
          "required": [
            "t"
          ]
        },
        {
          "$ref": "#/$defs/Cancel",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "cancel"
            }
          },
          "required": [
            "t"
          ]
        },
        {
          "$ref": "#/$defs/Subscribe",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "sub"
            }
          },
          "required": [
            "t"
          ]
        },
        {
          "$ref": "#/$defs/Event",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "evt"
            }
          },
          "required": [
            "t"
          ]
        },
        {
          "$ref": "#/$defs/Unsubscribe",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "unsub"
            }
          },
          "required": [
            "t"
          ]
        },
        {
          "$ref": "#/$defs/Records",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "rec"
            }
          },
          "required": [
            "t"
          ]
        },
        {
          "$ref": "#/$defs/Ack",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "ack"
            }
          },
          "required": [
            "t"
          ]
        },
        {
          "$ref": "#/$defs/GoAway",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "goaway"
            }
          },
          "required": [
            "t"
          ]
        }
      ],
      "description": "Any frame of protocol v1."
    },
    "Challenge": {
      "type": "object",
      "properties": {
        "sid": {
          "type": "string",
          "description": "Session ID, also covered by the signature."
        },
        "nonce": {
          "type": "string"
        }
      },
      "required": [
        "sid",
        "nonce"
      ],
      "description": "The gateway's first frame. The agent signs `nonce` in its [`Hello`]."
    },
    "AgentInfo": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "target": {
          "type": "string",
          "description": "Rust target triple of the build, such as `x86_64-unknown-linux-gnu`. It\npicks the release artifact for an update."
        },
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "boot_id": {
          "type": "string",
          "description": "Changes on every boot."
        },
        "machine_id_hash": {
          "type": "string",
          "description": "SHA-256 of the machine ID, never the raw ID."
        }
      },
      "required": [
        "version",
        "target",
        "os",
        "arch",
        "boot_id",
        "machine_id_hash"
      ],
      "description": "The agent build and the machine it runs on."
    },
    "HelloAuth": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string"
        },
        "key_id": {
          "type": "string"
        },
        "alg": {
          "$ref": "#/$defs/SigAlg"
        },
        "gen": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "Key generation counter. A mismatch locks the device (close 4403)."
        },
        "sig": {
          "type": "string",
          "description": "Signature over the challenge's sid and nonce, the gateway host, the IDs\nand `gen`, base64url without padding."
        }
      },
      "required": [
        "device_id",
        "key_id",
        "alg",
        "gen",
        "sig"
      ],
      "description": "Proof of possession of the device key."
    },
    "SigAlg": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Unknown"
          ]
        },
        {
          "type": "string",
          "const": "ES256",
          "description": "ECDSA with P-256 and SHA-256."
        }
      ],
      "description": "Signature algorithm of the device key."
    },
    "Caps": {
      "type": "object",
      "properties": {
        "ops": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "topics": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "default": {}
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "ops"
      ],
      "description": "What the device's policy lets Console call: operation and topic names with\nthe version of each, plus optional protocol features."
    },
    "PolicySummary": {
      "type": "object",
      "properties": {
        "hash": {
          "type": "string",
          "description": "SHA-256 of the normalized policy; empty when no valid policy is in force."
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why no valid policy is in force. The agent then denies everything."
        }
      },
      "required": [
        "hash"
      ],
      "description": "The device policy in force, by hash."
    },
    "OutboxState": {
      "type": "object",
      "properties": {
        "next_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "oldest_unacked": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "next_seq"
      ],
      "description": "Where the agent's outbox stands."
    },
    "Hello": {
      "type": "object",
      "properties": {
        "v": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Protocol major version."
        },
        "agent": {
          "$ref": "#/$defs/AgentInfo"
        },
        "auth": {
          "$ref": "#/$defs/HelloAuth"
        },
        "caps": {
          "$ref": "#/$defs/Caps"
        },
        "policy": {
          "$ref": "#/$defs/PolicySummary"
        },
        "outbox": {
          "$ref": "#/$defs/OutboxState"
        }
      },
      "required": [
        "v",
        "agent",
        "auth",
        "caps",
        "policy",
        "outbox"
      ],
      "description": "The agent's first frame: who it is, proof of its device key, and what its\npolicy lets Console call."
    },
    "HeartbeatConfig": {
      "type": "object",
      "properties": {
        "interval_ms": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "timeout_ms": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "interval_ms",
        "timeout_ms"
      ],
      "description": "How often the agent pings, and how long it waits for a pong."
    },
    "Limits": {
      "type": "object",
      "properties": {
        "max_frame_bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_inflight": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_rec_batch": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "max_frame_bytes",
        "max_inflight",
        "max_rec_batch"
      ],
      "description": "Limits the gateway enforces on this session."
    },
    "Subscribe": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "ver": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "data": {
          "default": null
        }
      },
      "required": [
        "id",
        "topic",
        "ver"
      ],
      "description": "Starts a live topic."
    },
    "Welcome": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string"
        },
        "hb": {
          "$ref": "#/$defs/HeartbeatConfig"
        },
        "acked_upto": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "description": "Highest outbox `seq` Console already has; the agent resends the rest."
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "subs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Subscribe"
          },
          "description": "Subscriptions to restore after a reconnect.",
          "default": []
        },
        "credential": {
          "type": [
            "string",
            "null"
          ],
          "description": "A renewed connection credential; the agent keeps it for its next connect."
        }
      },
      "required": [
        "session",
        "hb",
        "limits"
      ],
      "description": "The gateway's answer to a valid [`Hello`]."
    },
    "Actor": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "id": {
          "type": "string"
        },
        "via": {
          "type": [
            "string",
            "null"
          ],
          "description": "What carried the request, such as the dashboard or a named API token."
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "description": "Who asked for a request."
    },
    "ActorKind": {
      "type": "string",
      "enum": [
        "user",
        "api_token",
        "system",
        "unknown"
      ],
      "description": "The kind of [`Actor`]."
    },
    "Request": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ULID, also the audit ID on both sides."
        },
        "op": {
          "type": "string"
        },
        "ver": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "deadline_ms": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "data": {
          "default": null
        },
        "actor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Actor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Who asked, recorded for audit and never used for authorization."
        },
        "idem": {
          "type": [
            "string",
            "null"
          ],
          "description": "Retries of non-idempotent operations reuse this key, so they act once."
        }
      },
      "required": [
        "id",
        "op",
        "ver",
        "deadline_ms"
      ],
      "description": "A call to one operation."
    },
    "ErrorBody": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "msg": {
          "type": "string"
        },
        "retry": {
          "type": "boolean",
          "description": "Whether retrying the same request may succeed.",
          "default": false
        }
      },
      "required": [
        "code",
        "msg"
      ],
      "description": "Why a request failed."
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "bad_request",
        "unknown_op",
        "unsupported_version",
        "policy_denied",
        "not_found",
        "busy",
        "timeout",
        "cancelled",
        "internal",
        "device_offline",
        "link_lost",
        "unknown"
      ],
      "description": "Why an operation failed. Stable within a protocol major version; a code from\na newer revision decodes as `Unknown`."
    },
    "Response": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "data": true,
        "err": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorBody"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "ok"
      ],
      "description": "The final answer to a [`Request`]."
    },
    "Progress": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "data": {
          "default": null
        }
      },
      "required": [
        "id"
      ],
      "description": "Progress on a running request, before its [`Response`]."
    },
    "Cancel": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "description": "Asks to stop a running request. It is still answered by a [`Response`], with\n`cancelled` if it stopped in time."
    },
    "Event": {
      "type": "object",
      "properties": {
        "sub": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "data": true
      },
      "required": [
        "sub",
        "seq",
        "data"
      ],
      "description": "One message on a subscription."
    },
    "Unsubscribe": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "description": "Ends a subscription."
    },
    "OutboxRecord": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "$ref": "#/$defs/RecordKind"
        },
        "data": true
      },
      "required": [
        "seq",
        "type",
        "data"
      ],
      "description": "One outbox record."
    },
    "RecordKind": {
      "type": "string",
      "enum": [
        "audit_checkpoint",
        "metrics",
        "unknown"
      ],
      "description": "What an outbox record holds."
    },
    "Records": {
      "type": "object",
      "properties": {
        "recs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OutboxRecord"
          }
        }
      },
      "required": [
        "recs"
      ],
      "description": "Records from the agent's outbox, delivered at least once."
    },
    "Ack": {
      "type": "object",
      "properties": {
        "upto": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "upto"
      ],
      "description": "Confirms every record up to and including `upto`."
    },
    "ReconnectWindow": {
      "type": "object",
      "properties": {
        "min_ms": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_ms": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "min_ms",
        "max_ms"
      ],
      "description": "A random delay between `min_ms` and `max_ms` spreads reconnects out."
    },
    "GoAway": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "reconnect_after": {
          "$ref": "#/$defs/ReconnectWindow"
        }
      },
      "required": [
        "reason",
        "reconnect_after"
      ],
      "description": "Asks the agent to disconnect and come back within a window, for example\nduring a gateway deploy."
    },
    "NoParams": {
      "type": "object",
      "description": "Parameters of operations that take none: `{}` or an absent `data`."
    },
    "SystemInfo": {
      "type": "object",
      "properties": {
        "hostname": {
          "type": "string"
        },
        "os": {
          "$ref": "#/$defs/OsInfo"
        },
        "arch": {
          "type": "string",
          "description": "CPU architecture as Rust names it, such as `x86_64` or `aarch64`."
        },
        "kernel": {
          "type": "string",
          "description": "Kernel release, as `uname -r` prints it."
        },
        "boot_time": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "When the machine booted, in Unix seconds."
        },
        "agent_version": {
          "type": "string"
        }
      },
      "required": [
        "hostname",
        "os",
        "arch",
        "kernel",
        "boot_time",
        "agent_version"
      ],
      "description": "What `system.info` returns."
    },
    "OsInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "`ID`, such as `ubuntu`."
        },
        "name": {
          "type": "string",
          "description": "`PRETTY_NAME`, such as `Ubuntu 24.04.1 LTS`."
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "description": "`VERSION_ID`, such as `24.04`; absent on rolling releases."
        }
      },
      "required": [
        "id",
        "name"
      ],
      "description": "The OS, from os-release."
    },
    "ServiceList": {
      "type": "object",
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ServiceStatus"
          }
        }
      },
      "required": [
        "services"
      ],
      "description": "`service.list`: the services the device's service manager knows: system-wide\n(systemd's system units; launchd's system domain), then on macOS what runs\nin each logged-in user's session."
    },
    "ServiceStatus": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "description": "The name `service.restart` takes: a unit such as `nginx.service`, or a\nlaunchd label."
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "description": "What it is, when the service manager says: systemd's description.\nlaunchd keeps none."
        },
        "state": {
          "$ref": "#/$defs/ServiceState"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ],
          "description": "The service manager's own words for the state, such as systemd's\n`active (exited)` or launchd's last exit status."
        },
        "pid": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "description": "The main process, while it runs and the service manager reports it."
        },
        "protected": {
          "type": "boolean",
          "description": "The device policy keeps service actions off it."
        },
        "scope": {
          "$ref": "#/$defs/ServiceScope",
          "description": "Where it runs; system-wide when absent."
        },
        "user": {
          "type": [
            "string",
            "null"
          ],
          "description": "For `user` scope, whose session it runs in."
        },
        "kind": {
          "$ref": "#/$defs/ServiceKind",
          "description": "What it is; a service when absent."
        }
      },
      "required": [
        "unit",
        "state",
        "protected"
      ],
      "description": "One service and how it is."
    },
    "ServiceState": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "starting",
            "stopping",
            "unknown"
          ]
        },
        {
          "type": "string",
          "const": "running",
          "description": "Its process is running."
        },
        {
          "type": "string",
          "const": "exited",
          "description": "It ran and finished cleanly, such as a oneshot unit or an on-demand job\nbetween requests."
        },
        {
          "type": "string",
          "const": "stopped",
          "description": "Loaded but not running, and not since it last stopped cleanly."
        },
        {
          "type": "string",
          "const": "failed",
          "description": "It stopped with an error."
        }
      ],
      "description": "A service's state across service managers."
    },
    "ServiceScope": {
      "oneOf": [
        {
          "type": "string",
          "const": "system",
          "description": "System-wide: systemd's system units, launchd's system domain."
        },
        {
          "type": "string",
          "const": "user",
          "description": "A logged-in user's session: on macOS, their GUI domain, with their\nLaunchAgents and the apps they have open."
        }
      ],
      "description": "Where a service runs."
    },
    "ServiceKind": {
      "oneOf": [
        {
          "type": "string",
          "const": "service",
          "description": "A daemon, agent or unit that the service manager runs."
        },
        {
          "type": "string",
          "const": "app",
          "description": "An app open in a user's session. Its `unit` is the app's bundle ID and\nits `description` the app's name."
        }
      ],
      "description": "What a service is."
    },
    "AppQuit": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string"
        },
        "user": {
          "type": [
            "string",
            "null"
          ],
          "description": "Whose session; the one user logged in when absent."
        },
        "force": {
          "type": "boolean",
          "description": "Quit at once, as Force Quit does, losing unsaved work. Otherwise the app\nis asked to quit the way the Dock asks, and may ask to save first."
        }
      },
      "required": [
        "app"
      ],
      "description": "`app.quit`: one app to quit, named by its bundle ID as `service.list` gives it."
    },
    "AppQuitResult": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/QuitResult"
        }
      },
      "required": [
        "app",
        "result"
      ],
      "description": "How a quit went."
    },
    "QuitResult": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "unknown"
          ]
        },
        {
          "type": "string",
          "const": "quit",
          "description": "It closed."
        },
        {
          "type": "string",
          "const": "still_open",
          "description": "Asked to quit, it's still open: it may be asking to save changes."
        },
        {
          "type": "string",
          "const": "not_open",
          "description": "It wasn't open."
        }
      ]
    },
    "ServiceRef": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/ServiceScope",
          "description": "Where the service runs; system-wide when absent."
        },
        "user": {
          "type": [
            "string",
            "null"
          ],
          "description": "For `user` scope, whose session; the user at the console when absent."
        }
      },
      "required": [
        "unit"
      ],
      "description": "Names one service: a systemd unit such as `nginx.service`, or on macOS a\nlaunchd job's label, such as `homebrew.mxcl.nginx`."
    },
    "ServiceJob": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/JobResult"
        }
      },
      "required": [
        "unit",
        "result"
      ],
      "description": "The outcome of a service job."
    },
    "JobResult": {
      "type": "string",
      "enum": [
        "done",
        "canceled",
        "timeout",
        "failed",
        "dependency",
        "skipped",
        "unknown"
      ],
      "description": "A job result, as systemd reports it in `JobRemoved`. On macOS it is `done`\nonce launchd shows the job running again (or finished cleanly), `failed` if\nit exited with an error, and `timeout` if launchd doesn't say in time."
    },
    "StatsParams": {
      "type": "object",
      "properties": {
        "interval_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "description": "Sample interval; the agent raises anything below 1,000 ms to 1,000 ms."
        }
      },
      "description": "Parameters of the `stats` topic."
    },
    "StatsSample": {
      "type": "object",
      "properties": {
        "ts": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "When the sample was taken."
        },
        "cpu": {
          "$ref": "#/$defs/CpuStats"
        },
        "memory": {
          "$ref": "#/$defs/MemoryStats"
        }
      },
      "required": [
        "ts",
        "cpu",
        "memory"
      ],
      "description": "One live sample."
    },
    "CpuStats": {
      "type": "object",
      "properties": {
        "busy": {
          "type": "number",
          "format": "double",
          "description": "Busy time across all cores."
        },
        "load": {
          "$ref": "#/$defs/LoadAverage"
        }
      },
      "required": [
        "busy",
        "load"
      ],
      "description": "CPU use over the sample interval."
    },
    "LoadAverage": {
      "type": "object",
      "properties": {
        "one": {
          "type": "number",
          "format": "double"
        },
        "five": {
          "type": "number",
          "format": "double"
        },
        "fifteen": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "one",
        "five",
        "fifteen"
      ],
      "description": "Load averages over 1, 5 and 15 minutes."
    },
    "MemoryStats": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "available": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "What the kernel estimates new work can use (`MemAvailable`)."
        }
      },
      "required": [
        "total",
        "available"
      ],
      "description": "Memory at sample time."
    },
    "EnrollRequest": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        },
        "device_key": {
          "$ref": "#/$defs/PublicKey"
        },
        "audit_key": {
          "$ref": "#/$defs/PublicKey"
        },
        "host": {
          "$ref": "#/$defs/HostInfo"
        },
        "pop": {
          "type": "string",
          "description": "The device key's signature over [`signing_string`], base64url without\npadding."
        },
        "previous": {
          "anyOf": [
            {
              "$ref": "#/$defs/PreviousDevice"
            },
            {
              "type": "null"
            }
          ],
          "description": "The device this machine is enrolled as now, if any, so the gateway can\nretire it when the new one is created (D23)."
        },
        "replace": {
          "type": "boolean",
          "description": "Go ahead when `previous` is in another organization, or replace it in\nthe same one. Without it the gateway asks first: `confirm_move` or\n`already_enrolled`, leaving the token unused."
        }
      },
      "required": [
        "token",
        "device_key",
        "audit_key",
        "host",
        "pop"
      ],
      "description": "`POST /v1/enroll`."
    },
    "PublicKey": {
      "type": "object",
      "properties": {
        "alg": {
          "$ref": "#/$defs/SigAlg"
        },
        "key": {
          "type": "string",
          "description": "The uncompressed P-256 point, base64url without padding."
        }
      },
      "required": [
        "alg",
        "key"
      ],
      "description": "A public key."
    },
    "HostInfo": {
      "type": "object",
      "properties": {
        "hostname": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "machine_id_hash": {
          "type": "string",
          "description": "SHA-256 of the machine ID, never the raw ID."
        },
        "agent_version": {
          "type": "string"
        }
      },
      "required": [
        "hostname",
        "os",
        "arch",
        "machine_id_hash",
        "agent_version"
      ],
      "description": "The machine being enrolled."
    },
    "PreviousDevice": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string"
        },
        "sig": {
          "type": "string",
          "description": "The previous device key's signature over [`replace_signing_string`],\nbase64url without padding."
        }
      },
      "required": [
        "device_id",
        "sig"
      ],
      "description": "The device a machine is enrolled as, proven with that device's key."
    },
    "EnrollResponse": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string"
        },
        "key_id": {
          "type": "string",
          "description": "ID of the device key, carried in every hello."
        },
        "audit_key_id": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "Key generation counter; starts at 1."
        },
        "gateway_url": {
          "type": "string",
          "description": "Where the agent connects."
        },
        "credential": {
          "type": "string",
          "description": "The connection credential: a ticket the gateway checks before a\nconnection reaches its hub, sent as `Authorization: Bearer`. Opaque to the\nagent; the gateway renews it in a `welcome`."
        },
        "replaced": {
          "type": [
            "string",
            "null"
          ],
          "description": "The device this enrollment replaced, now removed from its organization."
        }
      },
      "required": [
        "device_id",
        "key_id",
        "audit_key_id",
        "generation",
        "gateway_url",
        "credential"
      ],
      "description": "What a successful enrollment returns."
    },
    "EnrollError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/EnrollErrorCode"
        },
        "msg": {
          "type": "string"
        },
        "from": {
          "type": [
            "string",
            "null"
          ],
          "description": "For `confirm_move`: the organization the machine is in now."
        },
        "to": {
          "type": [
            "string",
            "null"
          ],
          "description": "For `confirm_move` and `already_enrolled`: the token's organization."
        }
      },
      "required": [
        "code",
        "msg"
      ],
      "description": "Why an enrollment failed."
    },
    "EnrollErrorCode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "bad_request",
            "invalid_token",
            "token_expired",
            "token_used",
            "bad_signature",
            "internal",
            "unknown"
          ]
        },
        {
          "type": "string",
          "const": "already_enrolled",
          "description": "The machine is already in the token's organization; nothing changed."
        },
        {
          "type": "string",
          "const": "confirm_move",
          "description": "The machine is in another organization; enroll again with `replace`\nto move it."
        }
      ],
      "description": "Machine-readable reason in an [`EnrollError`]."
    },
    "StatsRecord": {
      "type": "object",
      "properties": {
        "ts": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "When the period ended."
        },
        "period_ms": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "How long the period was, in milliseconds."
        },
        "cpu": {
          "$ref": "#/$defs/CpuRecord"
        },
        "memory": {
          "$ref": "#/$defs/MemoryStats"
        }
      },
      "required": [
        "ts",
        "period_ms",
        "cpu",
        "memory"
      ],
      "description": "`metrics`: host stats over about a minute. CPU is averaged from counter\ndeltas across the period, with its busiest sample beside it; load and memory\nare the last values read."
    },
    "CpuRecord": {
      "type": "object",
      "properties": {
        "busy": {
          "type": "number",
          "format": "double",
          "description": "Busy time across all cores over the whole period."
        },
        "busy_max": {
          "type": "number",
          "format": "double",
          "description": "The busiest sample in the period."
        },
        "load": {
          "$ref": "#/$defs/LoadAverage"
        }
      },
      "required": [
        "busy",
        "busy_max",
        "load"
      ],
      "description": "CPU over a record's period."
    },
    "AuditCheckpoint": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "The sequence number of the last record it covers."
        },
        "head": {
          "type": "string",
          "description": "SHA-256 of that record's line, lowercase hex."
        },
        "ts": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "When privd signed it."
        },
        "key_id": {
          "type": "string",
          "description": "The audit key's ID, from enrollment."
        },
        "sig": {
          "type": "string",
          "description": "ES256 over [`checkpoint_signing_string`] with the audit key, base64url."
        }
      },
      "required": [
        "device_id",
        "seq",
        "head",
        "ts",
        "key_id",
        "sig"
      ],
      "description": "`audit_checkpoint`: privd's signature over the head of the device's audit\nlog. Console keeps them, so the log can later be checked against them."
    }
  }
}
